generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  PLAYING
  COMPLETED
  PLAN_TO_PLAY
  ON_HOLD
  DROPPED
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  name      String?
  createdAt DateTime       @default(now())
  entries   LibraryEntry[]
}

/// Copia local de la info de IGDB. El id es el mismo id de IGDB.
model Game {
  id            Int            @id
  slug          String         @unique
  name          String
  coverUrl      String?
  backgroundUrl String?
  released      DateTime?      @db.Date
  criticScore   Int? /// Nota de la crítica en IGDB (0-100)
  genres        String[]
  platforms     String[]
  updatedAt     DateTime       @updatedAt
  entries       LibraryEntry[]
}

model LibraryEntry {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      Int
  game        Game       @relation(fields: [gameId], references: [id])
  status      GameStatus @default(PLAN_TO_PLAY)
  score       Int? /// 1-10
  hoursPlayed Float?
  platform    String?
  startedAt   DateTime?  @db.Date
  finishedAt  DateTime?  @db.Date
  notes       String?
  favorite    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, gameId])
  @@index([userId, status])
}
